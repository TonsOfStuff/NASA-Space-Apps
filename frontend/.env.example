# Optional override. Development defaults to http://127.0.0.1:8000/api/route;
# production defaults to /api/route on the same origin.
# VITE_ROUTE_API_URL=http://localhost:8000/api/route
# Optional base URL for on-demand map layers when hosted separately.
# VITE_MAP_API_BASE_URL=http://localhost:8000/api

# Optional alternate region manifest; defaults to /data/gale/manifest.json.
# VITE_REGION_MANIFEST_URL=/data/other-region/manifest.json
